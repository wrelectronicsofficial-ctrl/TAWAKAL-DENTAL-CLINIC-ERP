# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# Enterprise Data Safety, Cloud Backup, Excel & WordPress Integrations
# Store actual values in Google Cloud Secret Manager / AI Studio Secrets (NEVER commit secrets)
# ------------------------------------------------------------------------------

# AES-256-GCM 64-char hex master encryption key (stored separately from backups)
BACKUP_ENCRYPTION_KEY=""

# Google Cloud Storage Private Backup Bucket & Optional Cloud KMS Key
GCS_BACKUP_BUCKET=""
GCS_KMS_KEY_NAME=""

# WordPress Site & Dedicated Least-Privilege Application Password
WP_SITE_URL=""
WP_APP_USER=""
WP_APP_PASSWORD=""
WP_BACKUP_HMAC_SECRET=""

# Microsoft Graph Excel Online / OneDrive / SharePoint OAuth 2.0
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT_ID="common"
